{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^nix/tuxedo-drivers/package\\.nix$/"
      ],
      "matchStrings": [
        "version = \"(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\";"
      ],
      "depNameTemplate": "tuxedo-drivers",
      "packageNameTemplate": "tuxedocomputers/development/packages/tuxedo-drivers",
      "datasourceTemplate": "gitlab-tags",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v(?<version>[0-9]+\\.[0-9]+\\.[0-9]+)$"
    }
  ]
}
